{
  "manifest_version": 2,
  "id": "maimai-drawpic-plugin",
  "version": "2.1.4",
  "name": "麦麦绘图",
  "description": "让麦麦拥有绘图能力，提供LLM工具、命令调用、在线WebUI，支持多平台多实例、文生图与图生图、模型与风格管理、任务追踪及插件联动",
  "author": {
    "name": "清蒸云鸭",
    "url": "https://github.com/WhiteCloudOL"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin",
    "homepage": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin",
    "documentation": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin/blob/main/README.md",
    "issues": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin/issues"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.20.0"
  },
  "dependencies": [
	{"type": "python_package", "name": "aiohttp", "version_spec": ">=3.9.0"},
	{"type": "python_package", "name": "google-genai", "version_spec": ">=1.58.0"},
	{"type": "python_package", "name": "pillow", "version_spec": ">=9.0.0"},
    {"type": "python_package", "name": "tomlkit", "version_spec": ">=0.13.3"}
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "llm.generate",
    "chat.get_all_streams",
    "chat.get_group_streams",
    "chat.get_private_streams",
    "chat.open_session",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_recent",
    "message.get_by_id",
    "webui.claim_upload"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN", "en-US", "ja-JP", "ko-KR"]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "database",
      "background": "#eff6fe"
    }
  }
}
