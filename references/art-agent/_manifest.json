{
  "manifest_version": 2,
  "id": "example.art-orchestrator",
  "version": "1.1.11",
  "name": "绘图编排层（参考实现 · 非可部署插件）",
  "description": "把一句绘图请求收敛成一个入口：由内置 LLM 判断需要哪些参考图、写什么提示词、每张参考图派什么用场，再交给绘图插件统一出图。保留主人物多参考图、场景预设、联网搜索参考图、聊天中抓取参考图四类图源；含三级取图、视觉审核、任务幂等与失败回退。本文件仅作参考实现声明，不对应可部署版本。",
  "author": {
    "name": "art-agent contributors",
    "url": "https://github.com/"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.10",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "api.call",
    "llm.generate",
    "send.text",
    "send.image",
    "message.get_by_id",
    "message.get_recent",
    "config.get",
    "component.get_all_plugins",
    "webui.claim_upload"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "image",
      "fallback": "image"
    }
  },
  "urls": {
    "repository": "https://github.com/",
    "homepage": "https://github.com/",
    "documentation": "https://github.com/",
    "issues": "https://github.com/"
  }
}
